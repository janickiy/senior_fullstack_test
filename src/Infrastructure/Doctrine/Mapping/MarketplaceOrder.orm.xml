<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Order\MarketplaceOrder" table="marketplace_order" repository-class="App\Repository\OrderRepository">
        <indexes>
            <index name="idx_shop_status_created" columns="shop_id,status,created_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_shop_marketplace" columns="shop_id,marketplace_id"/>
        </unique-constraints>
        <id name="id" type="integer"><generator strategy="AUTO"/></id>
        <field name="shopId" column="shop_id" length="64">
            <options><option name="collation">utf8mb4_bin</option></options>
        </field>
        <field name="marketplaceId" column="marketplace_id" length="255">
            <options><option name="collation">utf8mb4_bin</option></options>
        </field>
        <field name="status" length="20" enum-type="App\Domain\Order\OrderStatus"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="customerName" column="customer_name" length="255"/>
        <field name="customerPhone" column="customer_phone" length="12"/>
        <field name="deliveryType" column="delivery_type" length="20"/>
        <field name="district" length="64" nullable="true"/>
        <field name="address" type="text" nullable="true"/>
        <field name="deliveryStartsAt" column="delivery_starts_at" type="datetime_immutable" nullable="true"/>
        <field name="deliveryEndsAt" column="delivery_ends_at" type="datetime_immutable" nullable="true"/>
        <field name="items" type="json"/>
        <field name="itemsTotalCents" column="items_total_cents" type="bigint"/>
        <field name="marketplaceTotalCents" column="marketplace_total_cents" type="bigint"/>
        <field name="deliveryCostCents" column="delivery_cost_cents" type="bigint"/>
        <field name="grandTotalCents" column="grand_total_cents" type="bigint"/>
        <field name="needsReview" column="needs_review" type="boolean"/>
    </entity>
</doctrine-mapping>
